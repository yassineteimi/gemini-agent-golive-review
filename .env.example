# Copy to .env (git-ignored). Phase 0 needs none of this: the default stub model runs offline.

# stub = canned answers, no network (SIMULATED, see docs/simulated.md).
# gemini = configured below, but phase 0 never calls it.
AGENT_MODEL_MODE=stub

# Selects Gemini Enterprise Agent Platform (formerly Vertex AI) in google-genai and ADK.
# GOOGLE_GENAI_USE_VERTEXAI still works but is deprecated (docs/findings.md, F2).
GOOGLE_GENAI_USE_ENTERPRISE=1
GOOGLE_CLOUD_PROJECT=your-project-id

# `eu` is the multi-region endpoint, https://aiplatform.eu.rep.googleapis.com, which keeps
# ML processing inside EU member states. Not europe-west9: no current Gemini model has a
# Paris endpoint, and the SDK would build that URL without complaint (findings F3, F4).
GOOGLE_CLOUD_LOCATION=eu
MODEL_ID=gemini-3.8-flash

# Optional: where search_documents looks for *.md files. Defaults to ./data.
# BANQUE_DOCS_DIR=./data
